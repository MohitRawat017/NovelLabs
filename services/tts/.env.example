# NovelLabs TTS Service Environment Variables
# Copy to .env and fill in values

# GPU/CPU Toggle
# Set to "false" for CPU-only inference
USE_GPU=true

# Cloudflare R2 Credentials
# Create at: https://dash.cloudflare.com > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=76d048497ba7b21b79ec94371277decf
R2_ACCESS_KEY_ID=e88228ef961c54223bcef17308f8525a
R2_SECRET_ACCESS_KEY=98dd6134cd8fa93977d980bfe550a2b936988892fb2539c5c00f243bc1b31667
R2_BUCKET_NAME=novellabs-audio

# Optional: Custom domain for R2 bucket
# E.g., https://audio.novellabs.com
# If not set, uses default R2 URL format
R2_PUBLIC_URL=https://pub-bdacd5bc3da649b290a898acb3bbc9c8.r2.dev
