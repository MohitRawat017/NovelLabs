# NovelLabs backend + local ingestion example environment
# Copy to .env on your machine and fill in the real values.

# Shared database
DATABASE_BACKEND=postgres
DATABASE_URL=postgresql://username:password@localhost:5432/novellabs

# Local writable backend
READ_ONLY_MODE=false
AUTO_INIT_DB_SCHEMA=true
ENABLE_SCRAPING=true
ENABLE_TTS_GENERATION=true
API_URL=http://localhost:8001/api

# Local paths
NOVEL_OUTPUT_DIR=data/output
AUDIO_DIR=audio
TTS_VOICE_PROFILE_DIR=data/tts_profiles

# CORS / logging
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Default TTS settings
TTS_PROVIDER=kokoro
TTS_DEVICE=auto
TTS_VOICE=af_heart

# Qwen3 local service
QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_API_STYLE=demo
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_TTS_LANGUAGE=English
QWEN_TTS_TIMEOUT=180

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_OUTPUT_FORMAT=pcm_24000
ELEVENLABS_TIMEOUT=180
ELEVENLABS_VOICE_ID=

# Chapter text R2 bucket
R2_NOVEL_ACCOUNT_ID=
R2_NOVEL_ACCESS_KEY_ID=
R2_NOVEL_SECRET_ACCESS_KEY=
R2_NOVEL_BUCKET_NAME=
R2_NOVEL_PUBLIC_URL=

# Audio R2 bucket
R2_AUDIO_ACCOUNT_ID=
R2_AUDIO_ACCESS_KEY_ID=
R2_AUDIO_SECRET_ACCESS_KEY=
R2_AUDIO_BUCKET_NAME=
R2_AUDIO_PUBLIC_URL=

# Deprecated single-bucket fallback variables (only if you still need them)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=
