# NovelLabs Backend Environment Variables
# Copy to .env and fill in values

# TTS Service URL (Lightning AI)
# For local development: http://localhost:8002
# For production: https://your-lightning-app.lightning.ai
TTS_SERVICE_URL=https://8002-01kgfmybjskskdpg6xmhj7ehxs.cloudspaces.litng.ai/

# TTS request timeout (seconds)
TTS_TIMEOUT=30

# Database URL
# For local development: sqlite:///data/novels.db
# For production: postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://novellabs_db_user:f3XYxdWy1u58AAyTidu7DfeZHqksVPIA@dpg-d60ft69r0fns73fbmtd0-a.singapore-postgres.render.com/novellabs_db

# Audio storage backend
# cloud = Cloudflare R2 (production)
# local = Local filesystem (development only - NOT recommended for Render)
AUDIO_STORAGE_BACKEND=cloud

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://novel-labs.vercel.app

# Logging level
LOG_LEVEL=INFO
 