# NovelLabs Frontend Environment Variables
# Copy to .env.local and fill in values

# Backend API URL (MUST include /api suffix)
# For local development: http://localhost:8001/api
# For production: https://your-render-app.onrender.com/api
VITE_API_URL=https://novellabs.onrender.com/api


DATABASE_BACKEND=sqlite
SQLITE_DB_PATH=data/app.db
AUDIO_STORAGE_BACKEND=local
AUDIO_DIR=audio
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
SCRAPER_ENABLED=true

# TTS_PROVIDER=qwen3 #if you have more vram ! (15 mins/chapter on 8GB VRAM)
TTS_PROVIDER=kokoro
TTS_DEVICE=auto
TTS_VOICE=af_heart
TTS_VOICE_PROFILE_DIR=data/tts_profiles

QWEN_TTS_BASE_URL=http://127.0.0.1:8000
QWEN_TTS_API_STYLE=demo
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN_TTS_LANGUAGE=English
QWEN_TTS_TIMEOUT=180
